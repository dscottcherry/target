# Copy this file to ".env" and fill in your details to enable real email.
# Without these, sign-ups still work and emails are printed to the console.

# Port the server listens on
PORT=3000

# Token required to broadcast schedule updates via POST /api/notify
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Email (SMTP) ---------------------------------------------------
# Install the sender first:  npm install nodemailer
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Silver&Screen <hello@silverandscreen.example>
